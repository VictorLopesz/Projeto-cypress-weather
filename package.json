{
  "name": "cypress-weather",
  "version": "1.0.0",
  "description": "Automação E2E do widget de previsão do tempo do OpenWeatherMap (Cypress + Cucumber)",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run --browser chrome",
    "test:smoke": "cypress run --browser chrome --expose tags=@smoke",
    "test:regressao": "cypress run --browser chrome --expose tags=@regressao",
    "test:negativo": "cypress run --browser chrome --expose tags=@negativo",
    "test:mock": "cypress run --browser chrome --expose tags=@mock",
    "test:nao-funcional": "cypress run --browser chrome --expose tags=@nao-funcional",
    "typecheck": "tsc --noEmit -p cypress"
  },
  "keywords": [],
  "author": "Victor Lopes",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@types/node": "^26.6.3",
    "cypress": "^16.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "private": true,
  "allowScripts": {
    "cypress@16.1.1": true,
    "esbuild@0.28.2": true
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/support/step_definitions/**/*.ts",
    "filterSpecs": true,
    "omitFiltered": true
  }
}
